class NumArray {
    int[] segTree;
    int n;

    public NumArray(int[] nums) {
        n = nums.length;
        segTree = new int[4 * n];
        BuildTree(nums, 0, 0, n - 1);
    }

    public void update(int index, int val) {
        UpdateSegTree(index, val, 0, 0, n - 1);
    }

    public int sumRange(int left, int right) {
        return Query(left, right, 0, 0, n - 1);
    }

    public void BuildTree(int[] nums, int i, int l, int r) {
        // Base case: Leaf node represents a single array element.
        if (l == r) {
            segTree[i] = nums[l];
            return;
        }
        int mid = (l + r) / 2;

        // Build the left and right subtrees.
        BuildTree(nums, 2 * i + 1, l, mid);
        BuildTree(nums, 2 * i + 2, mid + 1, r);

        // Store the sum of both child segments in the current node.
        segTree[i] = segTree[2 * i + 1] + segTree[2 * i + 2];
    }

    public void UpdateSegTree(int idx, int val, int i, int l, int r) {
        // Base case: Reach the leaf node representing the target index.
        if (l == r) {
            segTree[i] = val;
            return;
        }
        int mid = (l + r) / 2;

        // Move to the child segment containing the target index.
        if (idx <= mid) {
            UpdateSegTree(idx, val, 2 * i + 1, l, mid);
        } else {
            UpdateSegTree(idx, val, 2 * i + 2, mid + 1, r);
        }
        // Recalculate the current node using the updated child sums.
        segTree[i] = segTree[2 * i + 1] + segTree[2 * i + 2];
    }

    public int Query(int start, int end, int i, int l, int r) {
        // Case 1: No overlap — the current segment is outside the query range.  
        if (start > r || end < l) {
            return 0;
        }
        // Case 2: Complete overlap — the current segment lies entirely
        //within the query range, so return it will definitely contribute to final sum.

        if (l >= start && r <= end) {
            return segTree[i];
        }
        // Case 3: Partial overlap, so we have to explore further and query both sides
        // and add the sums of the relevant portions.
        int mid = (l + r) / 2;
        return Query(start, end, 2 * i + 1, l, mid) + Query(start, end, 2 * i + 2, mid + 1, r);
    }
}

